# wechat-claw 用户配置（可选项）
# 放置：<项目根>/.config/config.yaml
# 不放置此文件 = 用户段全部使用内置默认值，本文件即默认值的完整参考。
# 说明：
#   - 运行参数（push/session/scheduler/log）由 bridge 内置，**不可在此配置**（文件不生效）
#   - 模块业务配置（城市/vault 路径等）属模块层，勿写进本文件
#   - 路径支持相对项目根写法（如 inbox、.config/crypto.key）；reject_dirs 的 agent-SDK 亦相对项目根

# opencode 子进程
acp:
  command: opencode
  port: 45678

# 文件发送三级规则（_send_file 单点执行；default 直发 / 其余 gate 微信确认 / reject 硬拒）
file_send:
  default_dirs:
    - ~/文档
    - ~/下载
    - ~/桌面
    - ~/图片
    - ~/音乐
    - ~/视频
    - ~/公共
    - inbox               # 相对项目根（微信收到的媒体文件目录）
  reject_dirs:
    - .config             # 相对项目根（用户配置/密钥目录，硬拒）
    - agent-SDK           # 相对项目根（微信 SDK 登录凭证目录，硬拒）
    - ~/.wechat-agent-sdk # 旧版 SDK 默认凭证目录（兼容，硬拒）
    - ~/.ssh
    - ~/.gnupg
  reject_name_re: token|secret|credential|private|accounts\.json|anniversaries\.json\.enc
  reject_suffixes:
    - .key
    - .pem
    - .p12
    - .pfx
    - .p8

# 隐私数据密钥
crypto:
  key_file: .config/crypto.key    # 相对项目根，自动生成（chmod 600）

# 模块自动更新（每日指纹驱动，静默；模块级开关在模块设置标题栏）
update:
  auto_enabled: true
  check_time: "04:00"             # 每日检查时刻（HH:MM）；源无变化零开销跳过
