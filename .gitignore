# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Frontend development dependencies
node_modules/
test-results/

# 用户配置目录（部署后生成，含配置/密钥/用户数据；备份 = 打包此目录）
.config/

# 打包产物（PyInstaller）
dist/
build/
*.spec.bak

# 运行产物
logs/
agent-SDK/scheduler_state.json
agent-SDK/retry_queue.json
.session_state.json
modules/*/*_sent.json

# 敏感文件（token / 密钥）
modules/**/token
agent-SDK/push_token
# 共享缓存（运行产物）
modules/common/shared/*.json

# 会话接续文档（分发改造用，不进分发产物）
PLAN.md

# WorkBuddy 工作区数据（不进仓库）
.workbuddy/

# 模块用户数据（modules_data/ 目录结构随主体同步，内容不进库；.gitkeep 保留目录）
modules/modules_data/*
!modules/modules_data/.gitkeep

# 模块源工作区（独立仓库 wechat-claw_modules_official，避免嵌套仓库）
wechat-claw_modules_official/

# 开发日志（不入库不推送）
devlog/

# 旧版前端备份（保留本地，不上传）
web/bak/

# opencode 二进制（构建时手动放入，不跟踪）
vendor/opencode/

# 审阅报告（本地产物，不入库）
ura-*.md

# opencode 二进制（构建时手动放入，不跟踪）
vendor/opencode/
