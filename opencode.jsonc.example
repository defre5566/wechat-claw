// wechat-claw 对话 agent 权限配置模板（opencode ACP 子进程加载）
// 使用：初始化向导「配置生成」步骤以此为准生成数据根 opencode.jsonc（cwd=数据根自动加载）；
//       生成时追加 instructions 字段（指向数据根 instructions/ 索引与当前档位文件）。
// 配套：deny 六项为硬性边界（逐条见下方清单），文件发送由 bridge 三级规则兜底。
// 注意：permission 对象按顺序匹配（后命中优先），宽规则在前、窄规则在后，勿调整顺序。
{
  "$schema": "https://opencode.ai/config.json",

  // 默认免费模型（零 API key 开箱即用）；自定义模型可改为 "provider/model" 形式
  "model": "opencode/mimo-v2.5-free",

  // 全索引装载：人设当前档位（tier-current 由 ensure_builtins/索引器保证存在）；
  // 指引正文不进 system，bridge 硬索引命中后按需拼接
  "instructions": ["instructions/tier-current.md"],

  "permission": {
    // 项目外目录访问：默认放开家目录（读个人文档/发送文件需要）；可收窄为具体目录，如 "~/文档/**": "allow"
    // 窄规则在后（后命中优先）：skills 外部目录与 SDK 凭证回落路径硬拒——agent 不得触碰
    // （skills 只允许由模块体系安装；~/.wechat-agent-sdk 为 SDK 未打补丁时的凭证回落目录）
    "external_directory": {
      "~/**": "allow",
      "~/.config/opencode/skill/**": "deny",
      "~/.config/opencode/skills/**": "deny",
      "~/.claude/skills/**": "deny",
      "~/.agents/skills/**": "deny",
      "~/.wechat-agent-sdk/**": "deny"
    },

    // 读：项目内默认放开，硬拒 token/密钥（安全红线，勿删）
    "read": {
      "**": "allow",
      "modules/**/token": "deny",
      "agent-SDK/**": "deny",
      "modules/**/anniversaries.json.enc": "deny",
      ".config/crypto.key": "deny",
      ".config/admin.password": "deny",
      "~/.wechat-agent-sdk/**": "deny"
    },

    // 写类：默认 ask（走微信确认）。
    // 权限模型（模块化定稿）：模块数据区 modules/modules_data/<name>/** 由 register 安装/启用时
    // 自动放行（含设置中的路径字段，如 Obsidian vault 目录），无需手动配置；
    // 模块越界豁免（改代码/应用外路径）由模块 module.json 自声明 + register 合并。
    // 以下示例仅为手动补充（路径请替换为自己的目录）：
    // "edit":  { "~/<个人目录>/**": "allow" },
    // "write": { "~/<个人目录>/**": "allow" }

    // ---- 写侧硬性限制（2026-08-22）：逃逸面 + bridge 核心 + skills，防 agent 越权 ----
    // 说明：权限 pattern 按"相对 worktree（数据根）"匹配（opencode 请求侧即相对路径）；
    //       worktree 外目录（~/...）的读/写规则不在此段生效，须写 external_directory 段。
    // 逃逸面：改这些 = 自授权力/改行为约束/改运行配置/改模块权限，硬拒
    "edit": {
      "opencode.jsonc": "deny",
      "AGENTS.md": "deny",
      ".config/**": "deny",
      "agent-SDK/**": "deny",
      // bridge 核心代码：改坏 = 服务崩，硬拒
      "bridge/**": "deny",
      // 项目内 skills 目录：agent 禁装（外部 skills 目录由 external_directory 段硬拒）
      ".opencode/skill/**": "deny",
      ".opencode/skills/**": "deny"
    },
    // install_skill 工具硬拒：agent 不得自装 skills（加载保留，供模块体系安装的 skill 使用）
    "install_skill": "deny",
    "write": {
      "opencode.jsonc": "deny",
      "AGENTS.md": "deny",
      ".config/**": "deny",
      "agent-SDK/**": "deny",
      "bridge/**": "deny",
      ".opencode/skill/**": "deny",
      ".opencode/skills/**": "deny"
    }
  }
}